// =============================================================================
// Docspyre AI - Prisma Schema (PostgreSQL)
// -----------------------------------------------------------------------------
// Design goals:
//   * Scalable, future-proof foundation that does not require redesign as the
//     product grows (multi-tenancy, RBAC, auditing, sessions are first-class).
//   * Every table uses UUID primary keys, created/updated timestamps and, where
//     relevant, soft-delete support so records are never hard-lost.
//   * Auth is session-based (DB-backed refresh tokens) on top of short-lived
//     access JWTs, enabling secure logout and token rotation.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  PENDING // registered, not yet verified
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  PASSWORD_CHANGED
  SESSION_REVOKED
}

// -----------------------------------------------------------------------------
// Identity & Access
// -----------------------------------------------------------------------------

/// Core principal of the system. Credentials are never stored in plain text.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  // Normalised, lower-cased email used for case-insensitive lookups.
  emailNormalized String     @unique @map("email_normalized")
  passwordHash    String     @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions        Session[]
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  auditLogs       AuditLog[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// A single authenticated session. Backs refresh-token rotation and logout.
/// Storing the hash (never the raw token) means a DB leak cannot resurrect
/// active sessions.
model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  // When rotated, points at the session that replaced this one (audit trail).
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// Multi-tenancy (Workspaces) — foundation for collaborative document AI
// -----------------------------------------------------------------------------

/// A tenant boundary. Documents, members and resources will hang off this.
model Workspace {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  slug    String @unique
  ownerId String @map("owner_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("workspaces")
}

/// Join table giving a user a role within a workspace (RBAC foundation).
model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// -----------------------------------------------------------------------------
// Observability / Security
// -----------------------------------------------------------------------------

/// Append-only security event log. `userId` is nullable so failed logins for
/// unknown principals can still be recorded.
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

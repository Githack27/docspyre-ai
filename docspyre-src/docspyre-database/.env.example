# -----------------------------------------------------------------------------
# Docspyre Database - environment template
# Copy to `.env` and adjust for your local machine. Never commit the real .env.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev aligns with the containerization plan: Postgres is reachable on
# host port 5434 (see docspyre-docs/containerization.md). If you run a locally
# installed Postgres on the default port, change 5434 -> 5432.
DATABASE_URL="postgresql://docspyre:docspyre@localhost:5434/docspyre?schema=public"

# Optional seed overrides (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@docspyre.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# -----------------------------------------------------------------------------
# Docspyre Backend - environment template
# Copy to `.env` for local development. Never commit the real .env.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# Must match docspyre-database/.env. Local dev uses host port 5434 (see
# docspyre-docs/containerization.md); change to 5432 for a native Postgres.
DATABASE_URL="postgresql://docspyre:docspyre@localhost:5434/docspyre?schema=public"

# Comma-separated CORS allow-list (the Angular dev server by default).
CORS_ORIGINS="http://localhost:4200"

# Auth secrets — MUST be >= 32 chars and unique per environment.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-min-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-min-32"

# Token lifetimes.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# bcrypt work factor (10-15). Higher = slower = more brute-force resistant.
BCRYPT_SALT_ROUNDS=12

# Optional cookie domain (leave unset for localhost).
# COOKIE_DOMAIN="localhost"

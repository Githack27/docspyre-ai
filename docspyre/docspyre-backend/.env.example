NODE_ENV=development
PORT=8000

# Must match docspyre-database/.env.
# Local install: default `postgres` superuser, no password, listening on 5434.
# Uses a dedicated database (`docspyre_app`) so the Prisma-managed schema does
# not collide with any other application sharing this Postgres instance.
DATABASE_URL="postgresql://postgres@localhost:5434/docspyre_app?schema=public"
# If your `postgres` user has a password, include it: postgres:<password>@...
# For the containerized stack, swap to the dedicated docspyre role
# (see docspyre-docs/containerization.md):
# DATABASE_URL="postgresql://docspyre:docspyre@localhost:5434/docspyre_app?schema=public"

CORS_ORIGINS="http://localhost:4200"
# When running the Tauri desktop app, also allow its webview origin(s):
#   Windows:       http://tauri.localhost
#   macOS/Linux:   tauri://localhost
# CORS_ORIGINS="http://localhost:4200,http://tauri.localhost,tauri://localhost"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret-min-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-min-32"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_SALT_ROUNDS=12

# Optional cookie domain (leave unset for localhost).
# COOKIE_DOMAIN="localhost"
# File uploads (My Documents). UPLOAD_DIR is relative to the backend working
# directory unless an absolute path is given.
UPLOAD_DIR="uploads"
# Max size for a single uploaded file, in bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600
# Days a soft-deleted document stays in Trash before automatic purge.
TRASH_RETENTION_DAYS=30

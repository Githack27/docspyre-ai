{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocSpyre",
  "version": "0.1.0",
  "identifier": "ai.docspyre.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run prepare:dev", "wait": true },
    "beforeBuildCommand": "npm run build:app",
    "devUrl": "http://127.0.0.1:4200",
    "frontendDist": "../frontend/dist/docspyre-desktop/browser",
    "additionalWatchFolders": ["../backend/src"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DocSpyre",
        "create": false,
        "visible": false,
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:4200 ws://127.0.0.1:4200; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main", "startup"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "DocSpyre Desktop",
    "externalBin": ["binaries/docspyre-node"],
    "resources": {
      "resources/backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}

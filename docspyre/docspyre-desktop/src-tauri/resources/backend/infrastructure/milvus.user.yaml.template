etcd:
  endpoints: 127.0.0.1:2379
  use:
    embed: true
  data:
    dir: /var/lib/milvus/etcd
  auth:
    enabled: false
localStorage:
  path: /var/lib/milvus/data
mq:
  type: rocksmq
rocksmq:
  path: /var/lib/milvus/rdb
common:
  storageType: local
  security:
    authorizationEnabled: true
    adminAuthEnabled: true
    defaultRootPassword: "__MILVUS_ROOT_PASSWORD__"

// =============================================================================
// Docspyre AI - Prisma Schema (PostgreSQL)
// -----------------------------------------------------------------------------
// Design goals:
//   * Scalable, future-proof foundation that does not require redesign as the
//     product grows (multi-tenancy, RBAC, auditing, sessions are first-class).
//   * Every table uses UUID primary keys, created/updated timestamps and, where
//     relevant, soft-delete support so records are never hard-lost.
//   * Auth is session-based (DB-backed refresh tokens) on top of short-lived
//     access JWTs, enabling secure logout and token rotation.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserStatus {
  PENDING // registered, not yet verified
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  PASSWORD_CHANGED
  SESSION_REVOKED
}

/// High-level classification of an uploaded document, driving previews/filters.
enum DocumentKind {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

/// Access level granted when a document is shared with another user.
enum SharePermission {
  VIEW
  DOWNLOAD
}

// -----------------------------------------------------------------------------
// Identity & Access
// -----------------------------------------------------------------------------

/// Core principal of the system. Credentials are never stored in plain text.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  // Normalised, lower-cased email used for case-insensitive lookups.
  emailNormalized String     @unique @map("email_normalized")
  passwordHash    String     @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions        Session[]
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  auditLogs       AuditLog[]
  uploadedFiles   WorkspaceFile[]   @relation("FileUploader")
  documents       Document[]        @relation("DocumentOwner")
  sharesSent      DocumentShare[]   @relation("SharesSent")
  sharesReceived  DocumentShare[]   @relation("SharesReceived")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// A single authenticated session. Backs refresh-token rotation and logout.
/// Storing the hash (never the raw token) means a DB leak cannot resurrect
/// active sessions.
model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  // When rotated, points at the session that replaced this one (audit trail).
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// Multi-tenancy (Workspaces) — foundation for collaborative document AI
// -----------------------------------------------------------------------------

/// A tenant boundary. Documents, members and resources will hang off this.
model Workspace {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  slug    String @unique
  ownerId String @map("owner_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]
  files   WorkspaceFile[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("workspaces")
}

/// Join table giving a user a role within a workspace (RBAC foundation).
model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// A file/document attached to a workspace (project). For now this stores
/// metadata only; binary storage is layered on later without schema churn.
model WorkspaceFile {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  uploadedById String? @map("uploaded_by_id") @db.Uuid
  /// Optional link to the owner's document library entry backing this file.
  documentId   String? @map("document_id") @db.Uuid
  name         String
  /// Free-form kind/mime hint (e.g. "application/pdf", "image").
  kind         String? @map("kind")
  /// Size in bytes (nullable until real uploads exist).
  sizeBytes    Int?    @map("size_bytes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([documentId])
  @@index([deletedAt])
  @@map("workspace_files")
}

/// A user's uploaded file (My Documents library). Binary lives on disk under
/// the configured upload directory keyed by `storageKey`; this row is the
/// metadata + soft-delete (Trash) record.
model Document {
  id         String       @id @default(uuid()) @db.Uuid
  ownerId    String       @map("owner_id") @db.Uuid
  name       String
  /// Opaque on-disk filename (uuid + extension).
  storageKey String       @map("storage_key")
  mimeType   String       @map("mime_type")
  kind       DocumentKind @default(OTHER)
  sizeBytes  Int          @map("size_bytes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// When set, the document is in Trash and eligible for auto-purge.
  deletedAt DateTime? @map("deleted_at")

  owner          User            @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceFiles WorkspaceFile[]
  shares         DocumentShare[]

  @@index([ownerId])
  @@index([kind])
  @@index([deletedAt])
  @@map("documents")
}

/// A direct share of a document from one user to another (RBAC via permission).
model DocumentShare {
  id           String          @id @default(uuid()) @db.Uuid
  documentId   String          @map("document_id") @db.Uuid
  sharedById   String          @map("shared_by_id") @db.Uuid
  sharedWithId String          @map("shared_with_id") @db.Uuid
  permission   SharePermission @default(VIEW)

  createdAt DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedBy   User     @relation("SharesSent", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith User     @relation("SharesReceived", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([documentId, sharedWithId])
  @@index([sharedWithId])
  @@index([sharedById])
  @@map("document_shares")
}

// -----------------------------------------------------------------------------
// Observability / Security
// -----------------------------------------------------------------------------

/// Append-only security event log. `userId` is nullable so failed logins for
/// unknown principals can still be recorded.
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

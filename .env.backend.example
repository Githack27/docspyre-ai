# Backend stack (docker-compose.backend.yml). Copy to .env.backend and fill in.

# Must match the credentials from the db stack. Host = Postgres service name.
DATABASE_URL=postgresql://docspyre:change-me-strong-password@docspyre-postgres:5432/docspyre_app?schema=public

# Public origin(s) allowed by CORS. With same-origin path routing this is your
# public site URL. Comma-separated for multiple.
CORS_ORIGINS=https://app.example.com

# Secrets: generate with `openssl rand -hex 32` (min 32 chars, must differ).
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Leave empty unless you scope the refresh cookie to a specific domain.
COOKIE_DOMAIN=

UPLOAD_DIR=uploads

# Docker volume mounting target for files (only relevant for container stack).
# In production/Dokploy, defaults to the named volume 'docspyre-uploads'.
# For local Docker compose smoke testing, you can override this to a local bind mount:
# BACKEND_UPLOAD_VOLUME="./docspyre/docspyre-backend/uploads"

MAX_UPLOAD_BYTES=104857600
TRASH_RETENTION_DAYS=30

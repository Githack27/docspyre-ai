# Database stack (docker-compose.db.yml). Copy to .env.db and fill in.

POSTGRES_USER=docspyre
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=docspyre_app

# Used by the migrate job. Host is the Postgres SERVICE name on the shared
# network, internal port 5432 (not the host-mapped 5434).
DATABASE_URL=postgresql://docspyre:change-me-strong-password@docspyre-postgres:5432/docspyre_app?schema=public

# Optional seed admin (only used if you enable the seed command).
SEED_ADMIN_EMAIL=admin@docspyre.local
SEED_ADMIN_PASSWORD=ChangeMe123!
